# Gemini API Key configuration for StudySnap
# Copy this file to .streamlit/secrets.toml or set as environment variables.
GEMINI_API_KEY = "your-gemini-api-key-here"

# Telegram Bot configuration for StudySnap session delivery
TELEGRAM_BOT_TOKEN = "your-telegram-bot-token-here"
TELEGRAM_CHAT_ID = "your-telegram-chat-id-here"
